{
  "name": "Omni Tools",
  "description": "Just some features for Omni (top-academy)",
  "version": "2.0.0",
  "author": "savelijln0@gmail.com",
  "manifest_version": 3,
  "permissions": [
		"cookies",
		"storage",
		"webRequest"
  ],
  "background": {
	  "service_worker": "background/background.js",
	  "type": "module"
  },
  "icons": {
	"128": "OmniTools_128x128.png"
  },
  "content_scripts": [
    {
		"js": [
			"scripts/libs/flubber.js",
			"scripts/libs/M3Loader.js",
			"scripts/libs/LightCore.js",
			"scripts/libs/UniqueColor.js",
			"scripts/libs/toaster.js",
			"scripts/libs/purify.min.js",
			"scripts/libs/DBStore.js",
			"scripts/darkTheme.js",
			"scripts/parsers.js",
			"scripts/codeBunch.js",
			"scripts/HomeworkPreview.js",
			"scripts/styles.js",
			"scripts/homeworkPage.js",
			"scripts/pageHook.js",
			"scripts/Settings.js",
			"scripts/silent_session_update.js"
		],
		"css": ["etc/static.css"],
        "matches": ["https://omni.top-academy.ru/*"]
    }
  ],
  "web_accessible_resources": [
	  {
		"resources": [
			"icons/general.svg",
			"icons/search.svg",
			"icons/filter.svg",
			"icons/fullscreen.svg",
			"icons/fullscreen_close.svg",
			"icons/cancel.svg",
			"icons/close.svg"
		],
		"matches": ["https://omni.top-academy.ru/*"]
	  }
  ],

  "action": {
    "default_popup": "popup/settings.html",
    "default_icon" : "OmniTools_128x128.png"
  },
  "host_permissions": [
    "https://*.top-academy.ru/*"
  ]
}